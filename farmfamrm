        -- the game has built its shop interface, which happens on its own.
        refreshShopAmount()
        TotalValue.Text = shopAmountLabel and shopAmountLabel.Text or "—"

        -- written directly: the whole display already refreshes faster than a
        -- tween would run, so one would only add work
        local fraction = dist and math.clamp(1 - dist / GAUGE_RANGE, 0, 1) or 0
        GaugeFill.Size = UDim2.new(fraction, 0, 1, 0)

        -- the button says what it is doing, so a click that seems to do nothing
        -- is explained
        HopBtn.Text = hopRunning and "Hopping…" or "Hop now"
        HopBtn.TextColor3 = hopRunning and C_DIM or C_TEXT

        -- the hop row doubles as a countdown
        if hopDesc then
            if not HOP_ENABLED then
                hopDesc.Text = "Off"
            elseif hopRunning then
                hopDesc.Text = "Looking for a smaller server"
            elseif not enabled then
                hopDesc.Text = string.format("Paused · %d min", math.floor(farmTime / 60))
            else
                local remaining = math.max(0, HOP_AFTER - farmTime)
                hopDesc.Text = string.format("Next in %dm %02ds",
                    math.floor(remaining / 60), math.floor(remaining % 60))
            end
        end

        if showErrors then
            setState("Error", C_ERR)
        elseif not enabled then
            setState("Idle", C_DIM)
        elseif bagIsFull then
            setState("Bag full", C_WARN)
        elseif dist then
            setState("Farming", C_ON)
        else
            setState("No coins", C_DIM)
        end
    end
end)

