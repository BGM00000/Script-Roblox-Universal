task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.15)

        local dist = nil
        if currentTarget and currentTarget.Parent and rootPart and rootPart.Parent
            and isFiniteVector(currentTarget.Position - rootPart.Position) then
            dist = (currentTarget.Position - rootPart.Position).Magnitude
        end

        CoinsValue.Text = tostring(coinsCollected)
        DistValue.Text = dist and string.format("%d", math.floor(dist + 0.5)) or "—"
        DistCaption.Text = dist and "studs to closest coin" or "no coin in range"

        local fraction = dist and math.clamp(1 - dist / GAUGE_RANGE, 0, 1) or 0
        TweenService:Create(GaugeFill, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {
            Size = UDim2.new(fraction, 0, 1, 0),
        }):Play()

        -- the hop row doubles as a countdown
        if hopDesc then
            if not HOP_ENABLED then
                hopDesc.Text = "Off"
            elseif hopRunning then
                hopDesc.Text = "Looking for a smaller server"
            elseif not enabled then
                hopDesc.Text = string.format("Paused · %d min", math.floor(farmTime / 60))
            else
                local remaining = math.max(0, HOP_AFTER - farmTime)
                hopDesc.Text = string.format("Next in %dm %02ds",
                    math.floor(remaining / 60), math.floor(remaining % 60))
            end
        end

        if showErrors then
            setState("Error", C_ERR)
        elseif not enabled then
            setState("Idle", C_DIM)
        elseif bagIsFull then
            setState("Bag full", C_WARN)
        elseif isWaitingForCoins then
            setState("Waiting", C_DIM)
        elseif dist then
            setState("Farming", C_ON)
        else
            setState("No coins", C_DIM)
        end
    end
end)

