local lastShopLookup = 0

-- the shop interface is not always there, so the label is looked up again
-- whenever the one we hold goes away. Its text is shown exactly as the game
-- writes it: it may use separators or shorten large numbers, and parsing that
-- back into a number would be guesswork.
local function refreshShopAmount()
    local now = os.clock()
    if (not shopAmountLabel or not shopAmountLabel.Parent) and now - lastShopLookup >= 1 then
        lastShopLookup = now
        shopAmountLabel = findShopAmount()
