            setState("Farming", C_ON)
        else
            setState("No coins", C_DIM)
        end
    end
end)

-- ---------------------------------- drag ----------------------------------
-- Mouse and finger, both: on a phone a panel that only answers the mouse cannot
-- be moved at all.
local dragging, dragStart, startPos = false, nil, nil

local function isPress(input)
    local kind = input.UserInputType
    return kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
end

local function isMove(input)
    local kind = input.UserInputType
    return kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch
end

Header.InputBegan:Connect(function(input)
    if isPress(input) then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

Header.InputEnded:Connect(function(input)
    if isPress(input) then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and isMove(input) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ============================== START ==============================
-- everything starts on, so the farm is already running when the panel appears
loadScript()
startAntiAfk()

-- the row already exists by now, so it can say what actually happened rather
-- than what was asked for
if not lowRenderWorks then
    lowRenderDesc.Text = "Not allowed by this executor"
end
