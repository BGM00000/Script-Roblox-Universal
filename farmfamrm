-- ===========================================================================
--  MM2 coin farm -- v3
--
--  Same shape as v2: fly at the closest coin, take it through a touch, look
--  again. What changed, and why:
--
--   * the coin list now comes from the map's own CoinContainer instead of a
--     scan of the whole workspace. Same coins, a fraction of the work per
--     frame, which matters on a phone.
--   * a coin is taken when its CoinVisual is gone or flagged -- the game's own
--     signal, not a guess about names.
--   * two guards against the 267 kick. A frame that stalls no longer turns into
--     one giant step, and when something other than this script moves the
--     character (the game pulling it back to the lobby, a respawn), the path
--     being followed is dropped instead of fought over.
--   * a 267 kick that got through anyway puts Roblox's own ErrorPrompt on the
--     screen; that prompt now fires the same hop as the panel button.
--
--  Load-bearing, do not "clean up":
--   * the character is moved by writing its CFrame. No physics actuator: a
--     velocity constraint fighting a teleport is what produces an impossible
--     position in the first place.
--   * collision is never switched back on while the character stands inside the
--     map. Depenetration would launch it at enormous speed.
-- ===========================================================================

if game.PlaceId ~= 142823291 then
    return
end
if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
local gameplayRemotes = remotes and remotes:WaitForChild("Gameplay", 5)


-- ============================== SETTINGS ==============================
local TARGET_SPEED = 20        -- studs per second. 21 is the ceiling this
                               -- script is tuned for: past it the step grows
                               -- faster than the game's own replication and
                               -- the practice stops being safe.
local MAX_DIST     = 1000       -- radius of the search. An MM2 map fits inside
                               -- this with room to spare; anything past it is
                               -- not a coin on this map.

-- The character is unanchored and noclipped, so the engine is free to nudge it.
-- Our own writes keep the real position on top of the virtual one; a gap this
-- wide means something else moved us, not that we drifted.
local RESYNC_DIST     = 20
local HOLD_MAX_DRIFT  = 8
local MAX_FRAME       = 1 / 15 -- one stalled frame must not become one jump

-- Where the coins live. Structure, not a guess: the active map holds a
-- CoinContainer, each coin under it carries a CoinVisual.
local CONTAINER_NAME = "CoinContainer"
local VISUAL_NAME    = "CoinVisual"

-- server hop
local HOP_ENABLED          = true
local HOP_AFTER            = 60 * 30
local HOP_MIN_PLAYERS      = 5
local HOP_MAX_PLAYERS      = 9
local HOP_PAGES            = 4
local HOP_RETRY_DELAY      = 10
local HOP_MAX_TRY_PER_PASS = 25
local HOP_ALLOW_FALLBACK   = true
-- no queue_on_teleport: the script lives in the executor's auto-execute folder,
-- so it comes back on its own. Queueing it as well would run two copies.
-- ======================================================================

local enabled   = true
local afkActive = true
local lowRender = true

local isLoaded       = false
local bagIsFull      = false
local showErrors     = false
local holdArmed      = false  -- may the script pin the character where it is
local lowRenderWorks = true   -- did the executor's call actually take

local activeCoins    = {}
local currentTarget  = nil
local coinsCollected = 0

local container   = nil
local containerConnection = nil

local heldCFrame = nil
local virtualPos = nil

local heartbeatConnection      = nil
local noclipConnection         = nil
local characterChildConnection = nil
local coinsStartedConnection   = nil
local coinCollectedConnection  = nil
local roundEndConnections      = {}
local antiAfkConnection        = nil
local characterAddedConnection = nil
local deviceSelectThread       = nil
local hopThread                = nil
local errorPromptThread        = nil

local farmTime   = 0
local hopsDone   = 0
local hopRunning = false

local ScreenGui = nil
local Main = nil
local hopDesc = nil

local characterParts = {}


-- ============================== HELPERS ==============================
-- NaN is what makes Roblox throw "Invalid position": a number that is not a
-- number, or an infinity, cannot be turned into a CFrame.
local function isFiniteNumber(n)
    return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function isFiniteVector(v)
    return isFiniteNumber(v.X) and isFiniteNumber(v.Y) and isFiniteNumber(v.Z)
end

local function currentRotation()
    if rootPart then
        local cf = rootPart.CFrame
        if cf and isFiniteVector(cf.Position) then
            return cf - cf.Position
        end
    end
    return CFrame.new()
end

local function stopMovement()
    heldCFrame = nil
    virtualPos = nil
    if rootPart then
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
end

-- Draw nothing but the interface. The farm moves by coordinates and takes coins
-- through touch events, so turning 3D rendering off changes nothing about what
-- it does. This is an executor capability: an executor without it keeps
-- rendering and says so in the panel.
local function setLowRender(state)
    lowRender = state and true or false
    local ok = pcall(function()
        RunService:Set3dRenderingEnabled(not lowRender)
    end)
    lowRenderWorks = ok
    return ok
end

-- Between two coins the character has nothing to stand on, so it would slowly
-- sink through the map. Putting its own CFrame back every frame keeps it where
-- it is, with nothing physical involved.
--
-- It only does that while the position it is holding is still roughly where the
-- character actually is. A game teleport is not a drift to correct: fighting it
-- is how a character ends up somewhere impossible. On a real move the hold is
-- dropped for good, until a coin is seen again and the round is clearly back on.
local function holdPosition()
    if not rootPart or not rootPart.Parent then return end
    virtualPos = nil

    if not heldCFrame then
        local cf = rootPart.CFrame
        if not isFiniteVector(cf.Position) then return end
        heldCFrame = cf
    end

    if (rootPart.Position - heldCFrame.Position).Magnitude > HOLD_MAX_DRIFT then
        heldCFrame = nil
        holdArmed = false
        return
    end

    rootPart.CFrame = heldCFrame
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
end

local function stepTowards(targetPos, dt)
    if not rootPart or not rootPart.Parent then return end

    local rootPos = rootPart.Position
    if not isFiniteVector(rootPos) then return end

    if not virtualPos or not isFiniteVector(virtualPos) then
        virtualPos = rootPos
    elseif (rootPos - virtualPos).Magnitude > RESYNC_DIST then
        -- Something other than us moved the character: the round ended and the
        -- game is putting it back in the lobby, or it respawned. The path we
        -- were following starts from a place we are no longer at.
        virtualPos = rootPos
    end

    -- an absolute position, not "current position + one step": with a relative
    -- move gravity adds up frame after frame and the character sinks through
    -- the map. Writing the intended position each frame wipes that out.
    local direction = targetPos - virtualPos
    local distance = direction.Magnitude
    if distance < 0.001 then return end

    -- never overshoot: the step stops exactly on the coin
    local step = math.min(TARGET_SPEED * math.min(dt, MAX_FRAME), distance)
    if step <= 0 then return end

    local newPos = virtualPos + direction.Unit * step
    if not isFiniteVector(newPos) then return end

    virtualPos = newPos
    heldCFrame = nil
    rootPart.CFrame = CFrame.new(newPos) * currentRotation()
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
end


-- ============================== NOCLIP ==============================
-- Anything the game adds to the character later (a tool, an accessory) has to be
-- picked up too, otherwise it is the one part that still collides with the world.
local function refreshCharacterParts()
    characterParts = {}
    if not character then return end
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            table.insert(characterParts, part)
        end
    end
end

local function watchCharacterParts()
    refreshCharacterParts()

    if characterChildConnection then
        characterChildConnection:Disconnect()
        characterChildConnection = nil
    end
    if not character then return end

    characterChildConnection = character.ChildAdded:Connect(function(child)
        if child:IsA("BasePart") and not table.find(characterParts, child) then
            table.insert(characterParts, child)
        end
    end)
end

local function startNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    watchCharacterParts()

    noclipConnection = RunService.Stepped:Connect(function()
        if not character or not enabled or not humanoid or humanoid.Health <= 0 then return end
        if bagIsFull then return end

        for i = 1, #characterParts do
            local part = characterParts[i]
            if part and part.Parent and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end
end

local function stopNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

-- Put collision back, carefully. After a whole round of noclip the character is
-- usually inside a wall or under the floor, and switching CanCollide on right
-- there makes Roblox depenetrate it: a body embedded in a large part is ejected
-- at enormous speed, and that launch is what ends up as an impossible position.
-- Lifting it clear first turns the ejection into a gentle settle.
local function restoreCollisionSafely()
    if rootPart and rootPart.Parent then
        local base = rootPart.Position
        if isFiniteVector(base) then
            pcall(function()
                rootPart.CFrame = CFrame.new(base + Vector3.new(0, 8, 0)) * currentRotation()
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    for _, part in ipairs(characterParts) do
        if part and part.Parent then
            part.CanCollide = true
        end
    end
end


-- ============================== ANTI-AFK ==============================
-- The plain one: the game says when the client has gone idle, and the click is
-- only sent then. Nothing runs in the background and nothing is clicked while
-- the player is active.
local function startAntiAfk()
    if antiAfkConnection then return end

    antiAfkConnection = player.Idled:Connect(function()
        if not afkActive then return end
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end


-- ============================== COINS ==============================
-- The game tags the map being played, and the coins of that map hang off its
-- CoinContainer. Reading the tag is what makes this exact: the lobby and the map
-- sit in the workspace at the same time, and only one of them is being played.
local function findCoinContainer()
    for _, map in ipairs(CollectionService:GetTagged("CurrentMap")) do
        local found = map:FindFirstChild(CONTAINER_NAME)
        if found then return found end
    end

    -- the tag is the game's, and it could go; this still finds the container
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local found = child:FindFirstChild(CONTAINER_NAME)
            if found then return found end
        end
    end

    return Workspace:FindFirstChild(CONTAINER_NAME, true)
end

local function coinVisualOf(coin)
    return coin:FindFirstChild(VISUAL_NAME)
end

-- A coin is takeable while it is still there and the game has not flagged it.
-- Collected goes on the coin and on its visual the instant it is banked -- by us
-- or by anybody else -- and the coin is then destroyed outright, so this is the
-- game's own answer to "is it still mine to take" and the only thing that
-- decides. A coin still standing there stays a candidate, even the one just
-- flown over.
--
-- Nothing here looks at Transparency, on purpose. The visual box is not what
-- makes a coin visible -- a mesh child is -- so that box is transparent, and a
-- transparency test would reject every coin on the map.
local function coinIsAvailable(coin)
    if not coin:IsA("BasePart") or not coin.Parent then return false end
    if coin:GetAttribute("Collected") then return false end

    local visual = coinVisualOf(coin)
    if not visual then return false end
    if visual:GetAttribute("Collected") then return false end

    return isFiniteVector(coin.Position)
end

local function findNearestCoin(rootPos)
    local nearest = nil
    local nearestDist = MAX_DIST

    for coin in pairs(activeCoins) do
        if not coin.Parent then
            -- gone from the tree for good; the round's own cleanup will not
            -- bring this object back
            activeCoins[coin] = nil
        elseif coinIsAvailable(coin) then
            local dist = (coin.Position - rootPos).Magnitude
            if dist < nearestDist then
                nearest = coin
                nearestDist = dist
            end
        end
    end

    return nearest
end

-- Fire the touch, both directions and both phases. A missing pickup is almost
-- always a touch that went to the wrong part or in the wrong direction, and the
-- four combinations cost nothing next to a missed coin. The coin part and its
-- visual are both tried: the game listens on one of them and this does not need
-- to know which.
local function fireBothWays(a, b)
    if not a or not b then return end
    if not a.Parent or not b.Parent then return end
    firetouchinterest(a, b, 0)
    firetouchinterest(a, b, 1)
    firetouchinterest(b, a, 0)
    firetouchinterest(b, a, 1)
end

-- Fired from wherever the character is while it flies over. Firing again on the
-- next frame is harmless and is what gives a touch a second chance if the first
-- one did not land. Wrapped, so a coin can never throw inside the frame loop.
local function collectCoin(coin)
    if not rootPart or not rootPart.Parent or not coin.Parent then return end

    local visual = coinVisualOf(coin)

    pcall(function()
        if not firetouchinterest then return end
        fireBothWays(rootPart, coin)
        fireBothWays(rootPart, visual)
    end)
end

-- The container is re-found from scratch on every round, because the map -- and
-- with it the container object -- is a new one each time.
local function unhookContainer()
    if containerConnection then
        containerConnection:Disconnect()
        containerConnection = nil
    end
end

local function rescanContainer()
    unhookContainer()
    activeCoins = {}
    currentTarget = nil
    container = findCoinContainer()

    if not container then
        warn("[AutoFarm] no " .. CONTAINER_NAME .. " in the workspace: nothing to farm")
        return
    end

    local count = 0
    for _, coin in ipairs(container:GetChildren()) do
        if coin:IsA("BasePart") then
            activeCoins[coin] = true
            count = count + 1
        end
    end

    -- coins keep appearing through the round; the list follows the game rather
    -- than being rebuilt on a timer
    containerConnection = container.ChildAdded:Connect(function(child)
        if child:IsA("BasePart") then
            activeCoins[child] = true
        end
    end)

    print(("[AutoFarm] %s: %d coin(s) at round start")
        :format(container:GetFullName(), count))
end

-- The bag is full: the round is over for us. The way this game banks a full bag
-- is to end the character, and the next one starts empty, so farming continues
-- instead of stalling on a bag that cannot take any more.
local function triggerBagFullReset()
    if bagIsFull then return end
    bagIsFull = true
    stopMovement()
    -- only stop enforcing noclip, do NOT put collision back: the character is
    -- standing inside the map after a whole round of it, which is exactly where
    -- turning collision on launches it
    stopNoclip()

    if humanoid and humanoid.Health > 0 then
        humanoid.Health = 0
    end
end

local function initCoinListeners()
    rescanContainer()

    if not gameplayRemotes then
        warn("[AutoFarm] gameplay remotes not found: the counter and the bag-full"
            .. " check are unavailable, farming still works")
        return
    end

    -- End of round, earliest signal first. The game is about to take the
    -- character back to the lobby, and it is the game that moves it. Letting go
    -- here, on the game's own signal, is what keeps our writes from racing it --
    -- that race is one of the ways a character ends up somewhere impossible.
    --
    -- VictoryScreen fires ~8s before RoundEndFade and ~40s before LoadingMap.
    -- GameOver is deliberately absent: it exists in the game, it was watched
    -- across five round changes, and it never fires.
    for _, name in ipairs({ "VictoryScreen", "RoundEndFade", "LoadingMap" }) do
        local signal = gameplayRemotes:FindFirstChild(name)
        if signal and signal:IsA("RemoteEvent") then
            table.insert(roundEndConnections, signal.OnClientEvent:Connect(function()
                stopMovement()
                holdArmed = false
            end))
        end
    end

    local coinsStartedRemote = gameplayRemotes:WaitForChild("CoinsStarted", 5)
    local coinCollectedRemote = gameplayRemotes:WaitForChild("CoinCollected", 5)

    if coinsStartedRemote then
        coinsStartedConnection = coinsStartedRemote.OnClientEvent:Connect(function()
            -- stopMovement also forgets where the character was, which matters
            -- here: it is about to be moved to a new map, and a remembered
            -- position from the old one would drag it back across the place
            stopMovement()
            holdArmed = false
            bagIsFull = false
            rescanContainer()
        end)
    end

    if coinCollectedRemote then
        -- The game announces every coin it banks, and passes its own running
        -- count with it. Read straight off the wire, the call is:
        --   CoinCollected -> string:Coin, number:2, number:40, table
        -- so (coinType, currentAmount, maxAmount, coin).
        --
        -- That is the honest source for the counter -- a touch that never landed
        -- cannot inflate it -- and it is also the exact moment to ask about the
        -- bag, since this fires when a coin has just been banked and at no other
        -- time. The bag is per round: the count runs 1..40 and starts over at the
        -- next CoinsStarted.
        coinCollectedConnection = coinCollectedRemote.OnClientEvent:Connect(
            function(_coinType, currentAmount, maxAmount)
                coinsCollected = coinsCollected + 1

                if type(currentAmount) == "number" and type(maxAmount) == "number"
                    and maxAmount > 0 and currentAmount >= maxAmount then
                    triggerBagFullReset()
                end
            end)
    end
end


-- ============================== DEVICE PROMPT ==============================
-- The game asks which device you are on when you join, and the prompt sits over
-- the screen until it is answered. Checked once a second for as long as the
-- button is there, since it comes back at the start of a round. Nothing happens
-- when it is absent.
local DEVICE_PATH = { "DeviceSelect", "Container", "Tablet", "Button" }

local function findDeviceSelectButton()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    local node = playerGui
    for _, name in ipairs(DEVICE_PATH) do
        node = node:FindFirstChild(name)
        if not node then return nil end
    end

    if not node.Visible then return nil end
    local deviceSelect = node:FindFirstAncestorOfClass("ScreenGui")
    if deviceSelect and not deviceSelect.Enabled then return nil end

    return node
end

-- Our panel sits above everything and is hit-tested first, so a real click aimed
-- at the prompt would land on the panel if the panel covers it.
local function panelCovers(x, y)
    if not Main or not Main.Parent then return false end
    local position = Main.AbsolutePosition
    local size = Main.AbsoluteSize
    return x >= position.X and x <= position.X + size.X
        and y >= position.Y and y <= position.Y + size.Y
end

local function clickGuiButton(button)
    if not button or not button.Parent then return end

    -- Method 1: fire the events the prompt listens to. This does not go through
    -- hit-testing, so it works with a panel in the way.
    pcall(function()
        if button:IsA("GuiButton") then
            button.MouseButton1Down:Fire(0, 0)
            button.MouseButton1Up:Fire(0, 0)
            button.MouseButton1Click:Fire()
        end
    end)

    -- Method 2: a real click, in case the prompt does not listen to the events
    -- above. It goes through the input system, so the game sees it exactly as if
    -- it had been pressed. The panel is hidden for the instant it takes if it is
    -- in the way.
    pcall(function()
        local center = button.AbsolutePosition + (button.AbsoluteSize * 0.5)
        local virtualInput = game:GetService("VirtualInputManager")

        local hidPanel = false
        if ScreenGui and panelCovers(center.X, center.Y) then
            ScreenGui.Enabled = false
            hidPanel = true
        end

        virtualInput:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
        task.wait(0.05)
        virtualInput:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)

        if hidPanel then ScreenGui.Enabled = true end
    end)
end

local function startDeviceSelectDismisser()
    if deviceSelectThread then return end

    deviceSelectThread = task.spawn(function()
        while isLoaded do
            local button = findDeviceSelectButton()
            if button then clickGuiButton(button) end
            task.wait(1)
        end
        deviceSelectThread = nil
    end)
end


-- ============================== SERVER HOP ==============================
--   * ask Roblox for the public server list of this place,
--   * keep the servers with a free slot, best match for the wanted size first,
--   * try them one by one; a teleport that does not throw can still fail (a full
--     server fires TeleportInitFailed instead of raising), so every attempt is
--     watched,
--   * and when a sweep finds nothing, start another one. It never gives up.
local function hopLog(message)
    print("[AutoFarm/hop] " .. tostring(message))
end

local function serverOrder(a, b)
    if a.off ~= b.off then return a.off < b.off end
    return a.playing > b.playing
end

local function fetchServers(cursor)
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
        :format(game.PlaceId)
    if cursor and cursor ~= "" and cursor ~= "null" then
        url = url .. "&cursor=" .. cursor
    end

    local httpRequest = (syn and syn.request) or (http and http.request)
        or (fluxus and fluxus.request) or http_request or request

    local body
    if httpRequest then
        local ok, res = pcall(function()
            return httpRequest({
                Url = url,
                Method = "GET",
                Headers = { ["Accept"] = "application/json", ["User-Agent"] = "Mozilla/5.0" },
            })
        end)
        if ok and res and res.Body then body = res.Body end
    end
    if not body then
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok then body = res end
    end
    if not body then return nil, nil end

    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
        return nil, nil
    end

    -- Nothing is filtered out except servers we cannot join. The API is asked
    -- newest-and-fullest first, which is the opposite of what a small-server
    -- band wants: those sit far down the list, so a strict "keep only the band"
    -- filter would throw away page after page. Instead each server carries how
    -- far outside the band it sits (0 = inside it) and the list is sorted by
    -- that, so the closest thing to what was asked for wins.
    local servers = {}
    for _, s in ipairs(decoded.data) do
        if type(s) == "table" and s.id and s.id ~= game.JobId then
            local playing = tonumber(s.playing) or 0
            local maxPlayers = tonumber(s.maxPlayers) or 12
            local free = maxPlayers - playing

            if free >= 1 then
                local off = 0
                if playing < HOP_MIN_PLAYERS then
                    off = HOP_MIN_PLAYERS - playing
                elseif playing > HOP_MAX_PLAYERS then
                    off = playing - HOP_MAX_PLAYERS
                end

                table.insert(servers, {
                    id = s.id,
                    playing = playing,
                    free = free,
                    off = off,
                })
            end
        end
    end

    table.sort(servers, serverOrder)

    local nextCursor = decoded.nextPageCursor
    if nextCursor == "null" then nextCursor = nil end
    return servers, nextCursor
end

-- Tries one server. Returns true only if the teleport really left.
local function tryTeleportTo(server)
    local failed = false
    local failResult = nil

    local conn
    conn = TeleportService.TeleportInitFailed:Connect(function(_, result)
        failed = true
        failResult = result
    end)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, player)
    end)

    if not ok then
        if conn then conn:Disconnect() end
        hopLog("Teleport error: " .. tostring(err))
        return false
    end

    local startedAt = os.clock()
    while not failed and (os.clock() - startedAt) < 3 do
        task.wait(0.2)
    end
    if conn then conn:Disconnect() end

    if not failed then return true end

    hopLog("Teleport refused: " .. tostring(failResult))
    return false
end

local function serverHop()
    if hopRunning then return end
    hopRunning = true
    hopsDone = hopsDone + 1

    stopMovement()
    hopLog(("Hop #%d: looking for a server with %d-%d players")
        :format(hopsDone, HOP_MIN_PLAYERS, HOP_MAX_PLAYERS))

    local round = 0
    while isLoaded do
        round = round + 1

        -- servers already refused during this hop, so the same dead ones are not
        -- tried twice in one pass. Kept in memory on purpose: a hop happens once
        -- per HOP_AFTER, by which point those servers are long gone.
        local seen = {}
        local inBand = {}
        local nearest = {}

        -- The whole sweep is read BEFORE anything is tried. A server inside the
        -- band can sit on page 2 while page 1 is full of servers outside it, and
        -- trying page 1 first would mean settling for the wrong one while the
        -- right one was two pages away.
        local cursor = nil
        for page = 1, HOP_PAGES do
            if not isLoaded then break end

            local servers, nextCursor = fetchServers(cursor)

            if servers then
                for _, server in ipairs(servers) do
                    if not seen[server.id] then
                        seen[server.id] = true
                        if server.off == 0 then
                            table.insert(inBand, server)
                        else
                            table.insert(nearest, server)
                        end
                    end
                end
            else
                hopLog(("Page %d: nothing readable"):format(page))
            end

            if not nextCursor then break end
            cursor = nextCursor
            task.wait(0.6)   -- small pause between two API calls
        end

        table.sort(nearest, serverOrder)

        if #inBand == 0 then
            local best = nearest[1]
            if best then
                hopLog(("Pass %d: no server at %d-%d players; closest is %d")
                    :format(round, HOP_MIN_PLAYERS, HOP_MAX_PLAYERS, best.playing))
            else
                hopLog(("Pass %d: no joinable server in the pages scanned"):format(round))
            end
        else
            hopLog(("Pass %d: %d server(s) in the %d-%d band")
                :format(round, #inBand, HOP_MIN_PLAYERS, HOP_MAX_PLAYERS))
        end

        local order = {}
        for _, server in ipairs(inBand) do table.insert(order, server) end
        if HOP_ALLOW_FALLBACK then
            for _, server in ipairs(nearest) do table.insert(order, server) end
        end

        local tried = 0
        for _, server in ipairs(order) do
            if not isLoaded then break end
            if tried >= HOP_MAX_TRY_PER_PASS then break end

            tried = tried + 1
            hopLog(("Try %d: %s (%d players, %d free)")
                :format(tried, server.id, server.playing, server.free))

            if tryTeleportTo(server) then
                hopRunning = false
                return
            end

            task.wait(0.5)
        end

        hopLog(("Pass %d finished (%d tried) -> new sweep"):format(round, tried))
        task.wait(HOP_RETRY_DELAY)
    end

    hopRunning = false
end

-- One way in for every hop, so the countdown starts over the same way whichever
-- one fired it: the panel button, the timer, being alone, an error prompt.
local function requestHop()
    if hopRunning then return end
    farmTime = 0
    task.spawn(serverHop)
end

-- Only counts while the farm is switched on, so the hour really is an hour of
-- farming.
local function startHopTimer()
    if hopThread then task.cancel(hopThread) end

    hopThread = task.spawn(function()
        local last = os.clock()
        while isLoaded do
            task.wait(1)
            local now = os.clock()
            farmTime = farmTime + (now - last)
            last = now

            if HOP_ENABLED and enabled and farmTime >= HOP_AFTER then
                requestHop()
            end
        end
    end)
end

-- One player in the server is one too few: no round ever starts.
local function startAloneWatch()
    task.spawn(function()
        while isLoaded do
            task.wait(10)
            if HOP_ENABLED and enabled and #Players:GetPlayers() <= 1 then
                hopLog("Alone in this server -> hopping out")
                requestHop()
            end
        end
    end)
end


-- ============================== ERROR PROMPT ==============================
-- A 267 kick that got through, a lost connection: Roblox puts its own
-- ErrorPrompt over the screen and the round is over, but the client is still up
-- and a hop is the way out. The path below is the one that prompt is documented
-- with, not a guess at a name.
--
-- Looked at once a second instead of waited on: the prompt stays on screen until
-- it is answered, so a look cannot miss it, and a connection to a GUI that may
-- not exist yet is one more thing to keep alive across a round change.
--
-- A prompt already answered never fires twice. A teleport does not take the
-- prompt off the screen, and firing on the same one again would hop out of every
-- server we land in.
local ERROR_PROMPT_PATH = { "RobloxPromptGui", "promptOverlay", "ErrorPrompt" }

local function errorPromptOnScreen()
    local node = game:GetService("CoreGui")
    for _, name in ipairs(ERROR_PROMPT_PATH) do
        node = node:FindFirstChild(name)
        if not node then return nil end
    end
    return node
end

local function startErrorPromptWatch()
    if errorPromptThread then return end

    errorPromptThread = task.spawn(function()
        local answered = nil
        while isLoaded do
            local prompt = errorPromptOnScreen()
            if prompt ~= answered then
                answered = prompt
                -- the farm switch is the one that decides: a paused script does
                -- not teleport anybody
                if prompt and enabled then
                    hopLog("Error prompt on screen -> hopping out")
                    requestHop()
                end
            end
            task.wait(1)
        end
        errorPromptThread = nil
    end)
end


-- ============================== FARM LOOP ==============================
local function cleanupConnections()
    if heartbeatConnection then heartbeatConnection:Disconnect() heartbeatConnection = nil end
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    if coinsStartedConnection then coinsStartedConnection:Disconnect() coinsStartedConnection = nil end
    if coinCollectedConnection then coinCollectedConnection:Disconnect() coinCollectedConnection = nil end
    if characterChildConnection then characterChildConnection:Disconnect() characterChildConnection = nil end
    for _, connection in ipairs(roundEndConnections) do
        connection:Disconnect()
    end
    roundEndConnections = {}
    unhookContainer()
end

local function updateFarm(dt)
    if not enabled or not rootPart or not rootPart.Parent or not humanoid or humanoid.Health <= 0 then
        stopMovement()
        return
    end

    -- the bag is full: the game is about to move the character, so we keep our
    -- hands off it
    if bagIsFull then
        stopMovement()
        return
    end

    local rootPos = rootPart.Position
    if not isFiniteVector(rootPos) then
        stopMovement()
        return
    end

    local nearest = findNearestCoin(rootPos)
    currentTarget = nearest

    if not nearest then
        -- Nothing to go to. If a coin has already been seen this life the round
        -- is on and there is simply a gap between spawns, so stay put instead of
        -- sinking through the map. Before that we are still in the lobby and the
        -- game is about to move us itself, so do not touch it at all.
        if holdArmed then
            holdPosition()
        else
            stopMovement()
        end
        return
    end

    holdArmed = true

    -- fire at it and keep flying. A shot fired from far away is ignored by the
    -- game and costs nothing: the character is still closing in, and the next
    -- frame fires again, from closer. That is why no radius is needed here.
    collectCoin(nearest)
    stepTowards(nearest.Position, dt)
end

local function startMovementEngine()
    cleanupConnections()
    initCoinListeners()
    heldCFrame = nil
    virtualPos = nil
    showErrors = false

    if enabled and not bagIsFull then startNoclip() end

    -- whatever happens in one frame, the farm keeps running instead of dying on
    -- the first error
    heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
        local ok, err = pcall(updateFarm, dt)
        if ok then
            showErrors = false
        else
            showErrors = true
            warn("[AutoFarm] " .. tostring(err))
            stopMovement()
        end
    end)
end

local function unloadScript()
    isLoaded = false
    enabled = false
    afkActive = false
    bagIsFull = false

    cleanupConnections()
    stopNoclip()
    restoreCollisionSafely()
    setLowRender(false)

    -- these loops stop on their own, isLoaded is already false
    deviceSelectThread = nil
    hopThread = nil
    errorPromptThread = nil

    if antiAfkConnection then
        antiAfkConnection:Disconnect()
        antiAfkConnection = nil
    end
    if characterAddedConnection then
        characterAddedConnection:Disconnect()
        characterAddedConnection = nil
    end
end

local function loadScript()
    if isLoaded then unloadScript() end
    isLoaded = true
    bagIsFull = false
    holdArmed = false

    character = player.Character or player.CharacterAdded:Wait()
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")

    coinsCollected = 0

    startMovementEngine()
    startDeviceSelectDismisser()
    startHopTimer()
    startAloneWatch()
    startErrorPromptWatch()
    setLowRender(lowRender)

    if characterAddedConnection then characterAddedConnection:Disconnect() end
    characterAddedConnection = player.CharacterAdded:Connect(function(newChar)
        cleanupConnections()

        character = newChar
        rootPart = character:WaitForChild("HumanoidRootPart")
        humanoid = character:WaitForChild("Humanoid")

        holdArmed = false
        bagIsFull = false
        heldCFrame = nil
        virtualPos = nil
        -- the new character is a fresh model with collision on by itself, so
        -- there is nothing to restore here

        task.wait(1.5)
        if isLoaded and enabled then
            startMovementEngine()
        end
    end)
end


